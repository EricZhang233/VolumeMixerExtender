#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VMEX_VERSION_COMMA@
 PRODUCTVERSION @VMEX_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @VMEX_RC_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "@VMEX_RC_DESCRIPTION@"
            VALUE "FileVersion", "@VMEX_VERSION@"
            VALUE "InternalName", "@VMEX_RC_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@VMEX_RC_ORIGINAL_NAME@"
            VALUE "ProductName", "@VMEX_PRODUCT_NAME@"
            VALUE "ProductVersion", "@VMEX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
