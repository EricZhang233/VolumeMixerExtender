set(vmex_diagnostics_version "10.0.26100.3916")
set(vmex_diagnostics_package_hash "21dfb5db3397425ee428e0fd54cedc51af52ddd10c82433a7cdb483ecbb284ad")
set(vmex_diagnostics_dll_hash "a7030573facf17b40579cc14b0e6b4976f112cbcd6b5f58ad2d3138066c058e4")
set(vmex_diagnostics_cache "${CMAKE_SOURCE_DIR}/obj/sdk-deps/${vmex_diagnostics_version}")
set(vmex_diagnostics_archive "${vmex_diagnostics_cache}/Microsoft.Windows.SDK.CPP.nupkg")
set(vmex_diagnostics_member "c/bin/x64/XamlDiagnostics/xamldiagnostics.dll")
set(vmex_diagnostics_cached_hash "")
if(EXISTS "${vmex_diagnostics_cache}/${vmex_diagnostics_member}")
    file(SHA256 "${vmex_diagnostics_cache}/${vmex_diagnostics_member}" vmex_diagnostics_cached_hash)
endif()
if(NOT vmex_diagnostics_cached_hash STREQUAL vmex_diagnostics_dll_hash)
    file(MAKE_DIRECTORY "${vmex_diagnostics_cache}")
    set(vmex_diagnostics_archive_hash "")
    if(EXISTS "${vmex_diagnostics_archive}")
        file(SHA256 "${vmex_diagnostics_archive}" vmex_diagnostics_archive_hash)
    endif()
    if(NOT vmex_diagnostics_archive_hash STREQUAL vmex_diagnostics_package_hash)
        set(vmex_diagnostics_url "https://api.nuget.org/v3-flatcontainer/microsoft.windows.sdk.cpp/${vmex_diagnostics_version}/microsoft.windows.sdk.cpp.${vmex_diagnostics_version}.nupkg")
        foreach(vmex_diagnostics_attempt RANGE 1 3)
            file(DOWNLOAD "${vmex_diagnostics_url}" "${vmex_diagnostics_archive}"
                TLS_VERIFY ON TIMEOUT 180 STATUS vmex_diagnostics_download)
            list(GET vmex_diagnostics_download 0 vmex_diagnostics_download_code)
            set(vmex_diagnostics_archive_hash "")
            if(EXISTS "${vmex_diagnostics_archive}")
                file(SHA256 "${vmex_diagnostics_archive}" vmex_diagnostics_archive_hash)
            endif()
            if(vmex_diagnostics_download_code EQUAL 0 AND vmex_diagnostics_archive_hash STREQUAL vmex_diagnostics_package_hash)
                break()
            endif()
        endforeach()
        if(NOT vmex_diagnostics_download_code EQUAL 0 OR NOT vmex_diagnostics_archive_hash STREQUAL vmex_diagnostics_package_hash)
            message(FATAL_ERROR "Windows SDK package download or SHA256 verification failed: ${vmex_diagnostics_download}")
        endif()
    endif()
    file(ARCHIVE_EXTRACT INPUT "${vmex_diagnostics_archive}" DESTINATION "${vmex_diagnostics_cache}"
        PATTERNS "${vmex_diagnostics_member}")
    file(SHA256 "${vmex_diagnostics_cache}/${vmex_diagnostics_member}" vmex_diagnostics_cached_hash)
    if(NOT vmex_diagnostics_cached_hash STREQUAL vmex_diagnostics_dll_hash)
        message(FATAL_ERROR "Windows SDK x64 diagnostics DLL SHA256 verification failed")
    endif()
endif()
set(VMEX_DIAGNOSTICS_DLL "${vmex_diagnostics_cache}/${vmex_diagnostics_member}")
message(STATUS "XAML diagnostics: official Windows SDK ${vmex_diagnostics_version} x64, SHA256 verified")
