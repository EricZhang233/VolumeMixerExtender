#include <winver.h>

1 VERSIONINFO
FILEVERSION @VMEX_VERSION_COMMA@
PRODUCTVERSION @VMEX_VERSION_COMMA@
FILETYPE VFT_DRV
FILESUBTYPE VFT2_DRV_SOUND
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "VolumeMixerExtender recording endpoint"
   VALUE "FileVersion", "@VMEX_VERSION@"
   VALUE "ProductName", "VolumeMixerExtender"
   VALUE "ProductVersion", "@VMEX_VERSION@"
   VALUE "OriginalFilename", "vmex_recording.sys"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

VMEX_SYSVAD_LICENSE RCDATA "@VMEX_SYSVAD_SOURCE@/LICENSE"
