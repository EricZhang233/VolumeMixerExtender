[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=vmex_recording.cat
DriverVer=10/28/2026,@VMEX_DRIVER_VERSION@
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTamd64.10.0...26300

[Devices.NTamd64.10.0...26300]
%DeviceName%=Install,ROOT\VMEX_RECORDING

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Provider%,,,

[SourceDisksFiles]
vmex_recording.sys=1

[DriverCopy]
vmex_recording.sys

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=DriverReg

[DriverReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,vmex_recording.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[Install.NT.Services]
AddService=vmex_recording,0x00000002,Service

[Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\vmex_recording.sys

[Install.NT.Wdf]
KmdfService=vmex_recording,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Install.NT.Interfaces]
AddInterface=%Audio%,WaveSpeaker,Wave
AddInterface=%Render%,WaveSpeaker,Wave
AddInterface=%Realtime%,WaveSpeaker,Wave
AddInterface=%Audio%,TopologySpeaker,Topology
AddInterface=%TopologyCategory%,TopologySpeaker,Topology

[Wave]
AddReg=WaveReg

[WaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%EndpointName%

[Topology]
AddReg=TopologyReg

[TopologyReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
HKR,EP\0,%DisableEffects%,0x00010001,1

[Strings]
Provider="EricSoft"
DeviceName="VolumeMixerExtender"
EndpointName="OC Virtual Speaker"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
TopologyCategory="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
AnyNode="{00000000-0000-0000-0000-000000000000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
DisableEffects="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},5"
